# Writes <prefix>/<libdir>/pkgconfig/robotraconteur-go.pc at install time
# (included from the install(CODE) in CMakeLists.txt).
#
# Inputs: RRGO_PREFIX, RRGO_LIBDIR, RRGO_LINK_LIBS_FILE (one linker item per
# line: the core and its dependencies, from cmake/GoLinkFlags.cmake),
# RRGO_SYSTEM_LIBS, RRGO_VERSION (of the Go bindings), RRGO_CORE_VERSION, RRGO_LINK_GROUP (wrap the archives in
# -Wl,--start-group/--end-group; not on macOS).
#
# cgo reads the file through "#cgo pkg-config: robotraconteur-go" and checks
# every flag against its allowlist, so shared libraries with a version suffix
# (libboost_thread.so.1.83.0) are rewritten to -L<dir> -l<name>.
#
# Cflags carries -DRRGO_NATIVE_FINGERPRINT=<hash of the installed archives>.
# Go's build cache does not look at the archives named in LDFLAGS, but it does
# hash the flags: a rebuilt native library changes the fingerprint, so Go
# programs are relinked against it.

set(_libdir "${RRGO_PREFIX}/${RRGO_LIBDIR}")
set(_native "${_libdir}/libRobotRaconteurGoNative.a")
file(STRINGS "${RRGO_LINK_LIBS_FILE}" _items)

set(_libs "")
set(_archives "${_native}")
foreach(_it IN LISTS _items)
    if(_it MATCHES "^(.*)/lib([^/]+)\\.(so|dylib)(\\.[0-9.]+)?$")
        list(APPEND _libs "-L${CMAKE_MATCH_1}" "-l${CMAKE_MATCH_2}")
    else()
        list(APPEND _libs "${_it}")
        if(_it MATCHES "\\.a$" AND EXISTS "${_it}")
            list(APPEND _archives "${_it}")
        endif()
    endif()
endforeach()
list(REMOVE_DUPLICATES _libs)
# archives installed under the prefix (the core) are written relative to libdir
list(TRANSFORM _libs REPLACE "^${_libdir}/" "\${libdir}/")
string(JOIN " " _libs_str ${_libs})

set(_fp "")
foreach(_a IN LISTS _archives)
    file(MD5 "${_a}" _h)
    string(APPEND _fp "${_h}")
endforeach()
string(MD5 _fp "${_fp}")
string(SUBSTRING "${_fp}" 0 16 _fp)

# GNU ld needs a group for the circular dependencies between the archives; ld64 (macOS) does not have the option.
set(_native_pc "\${libdir}/libRobotRaconteurGoNative.a")
if(NOT RRGO_LINK_GROUP)
    set(_link "${_native_pc} ${_libs_str}")
else()
    set(_link "-Wl,--start-group ${_native_pc} ${_libs_str} -Wl,--end-group")
endif()

set(_pc "${_libdir}/pkgconfig/robotraconteur-go.pc")
if(DEFINED ENV{DESTDIR})
    set(_pc "$ENV{DESTDIR}${_pc}")
endif()
file(
    WRITE "${_pc}"
    "# Generated by robotraconteur_go (cmake/write_pkgconfig.cmake)
prefix=${RRGO_PREFIX}
libdir=\${prefix}/${RRGO_LIBDIR}

Name: robotraconteur-go
Description: Native libraries of the Robot Raconteur Go bindings (static; Robot Raconteur core ${RRGO_CORE_VERSION})
Version: ${RRGO_VERSION}
Cflags: -DRRGO_NATIVE_FINGERPRINT=${_fp}
Libs: ${_link} ${RRGO_SYSTEM_LIBS}
")
message(STATUS "Installing: ${_pc} (fingerprint ${_fp})")
